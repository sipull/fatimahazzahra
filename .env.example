# ============================================================
# TEMPLATE VARIABEL LINGKUNGAN — E-Portofolio PPG
#
# Cara pakai:
#   1. Salin berkas ini menjadi `.env` (untuk lokal)
#      atau isi nilainya di Settings → Environment Variables
#      pada Vercel / Netlify / Render (untuk produksi)
#   2. Ganti setiap nilai di bawah tanda "="
#   3. JANGAN pernah mengunggah berkas .env berisi nilai asli
#      ke repositori publik
# ============================================================


# ------------------------------------------------------------
# 1. DATABASE (WAJIB)
# ------------------------------------------------------------
# Koneksi PostgreSQL. Gratis di: neon.tech, supabase.com, railway.app
# Contoh bentuk nilai:
#   postgresql://user:password@host:5432/namadb?sslmode=require
DATABASE_URL=


# ------------------------------------------------------------
# 2. KATA SANDI ADMIN (WAJIB)
# ------------------------------------------------------------
# Dipakai untuk masuk ke /admin/login
# Sifatnya: hanya dibaca di server, tidak pernah dikirim ke browser.
# Gunakan sandi panjang, campuran huruf, angka, dan simbol.
ADMIN_PASSWORD=


# ------------------------------------------------------------
# 3. KUNCI SESI (WAJIB UNTUK PRODUKSI)
# ------------------------------------------------------------
# Dipakai menandatangani cookie sesi (HMAC-SHA256).
# JANGAN mengisi nilai ini sama dengan ADMIN_PASSWORD.
# Cara membuat nilai acak:
#   openssl rand -base64 48
#   atau di Node.js: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=


# ------------------------------------------------------------
# 4. PENYIMPANAN BERKAS (OPSIONAL — untuk Vercel/Netlify)
# ------------------------------------------------------------
# Folder `public/uploads` TIDAK persisten di hosting serverless.
# Jika hanya berjalan di VPS/Render/Docker, biarkan kosong.
# Untuk Vercel, isi salah satu layanan berikut:
#   BLOB_READ_WRITE_TOKEN   → token dari Vercel Blob
#   CLOUDINARY_URL          → cloudinary://api_key:api_secret@cloud_name
# Biarkan kosong bila belum memakai layanan tersebut.
BLOB_READ_WRITE_TOKEN=
CLOUDINARY_URL=
